# =============================================================================
# Clinix.ai – production environment template
#
# Copy to .env.production and fill in real values. NEVER commit .env.production.
#   cp .env.production.example .env.production
#
# All three containers (frontend build args excluded) read this file via the
# `env_file:` directive in docker-compose.prod.yml.
# =============================================================================

# ---- Edge / reverse proxy --------------------------------------------------
# Bare Azure VM (HTTP only, no DNS):   SITE_ADDRESS=:80
# Azure DNS label / custom domain:     SITE_ADDRESS=clinixai-demo.eastus.cloudapp.azure.com
SITE_ADDRESS=:80
# Optional, used by Caddy for Let's Encrypt notifications when using a domain.
ACME_EMAIL=admin@example.com

# ---- Public URLs (used for CORS, Socket.IO, Stripe redirects) --------------
# Replace VM_PUBLIC_IP_OR_DOMAIN with your Azure VM public IP or DNS label.
# For HTTP-only demos keep http://, switch to https:// once TLS is active.
FRONTEND_URL=http://VM_PUBLIC_IP_OR_DOMAIN
PUBLIC_API_URL=http://VM_PUBLIC_IP_OR_DOMAIN/api
# Comma-separated allow-list for backend CORS (Express). Include every origin
# you expect browsers to call the API from (VM IP, DNS label, https variants).
CORS_ORIGIN=http://VM_PUBLIC_IP_OR_DOMAIN

# ---- Node backend ----------------------------------------------------------
NODE_ENV=production
PORT=5000
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# MongoDB Atlas – use the SRV connection string from Atlas > Connect > Drivers.
# Remember to whitelist the Azure VM public IP under Atlas > Network Access.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/clinix_ai?retryWrites=true&w=majority

# ---- AI service (talks to OpenAI) ------------------------------------------
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4.1-mini
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_API_BASE_URL=https://api.openai.com/v1

# ---- AI service internal URL (do not change unless you rename the service) -
AI_SERVICE_URL=http://ai-service:8001
PYTHON_AI_SERVICE_URL=http://ai-service:8001

# ---- Uploads ---------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
UPLOAD_AUDIO_DIR=uploads/audio
UPLOAD_REPORTS_DIR=uploads/reports

# ---- External clinical APIs (optional) -------------------------------------
RXNORM_API_ID=
OPENFDA_API_KEY=

# ---- Stripe (optional, only if subscriptions are demoed) -------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://VM_PUBLIC_IP_OR_DOMAIN/subscription/success
STRIPE_CANCEL_URL=http://VM_PUBLIC_IP_OR_DOMAIN/subscription/cancel

# ---- Twilio WhatsApp -------------------------------------------------------
# Configure the webhook in the Twilio console (WhatsApp sandbox or sender) to:
#   http://VM_PUBLIC_IP_OR_DOMAIN/api/webhooks/twilio/whatsapp
# TWILIO_WEBHOOK_URL MUST match exactly (scheme + host + path) – Twilio signs
# the request using this URL and the backend will reject mismatches.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_WEBHOOK_URL=http://VM_PUBLIC_IP_OR_DOMAIN/api/webhooks/twilio/whatsapp
TWILIO_WEBHOOK_VALIDATE=true

# ---- Demo / bootstrap ------------------------------------------------------
DEMO_MODE=false
REMINDER_RUN_SECRET=replace-with-a-random-string
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FULL_NAME=Super Admin

# ---- Google Cloud (optional – only if Google Speech is enabled) ------------
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-speech.json
GOOGLE_CLOUD_API_KEY=
