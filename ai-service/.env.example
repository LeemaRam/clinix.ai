# AI Service Configuration
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001
PORT=8000

# AI APIs
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# External APIs
RXNORM_API_ID=your-rxnorm-api-id-here

# Upload Configuration
MAX_FILE_MB=50

# Environment
NODE_ENV=production
DEMO_MODE=false
STRICT_FFMPEG=true
# Shared internal API key required on all AI processing endpoints.
# Development falls back to dev-key-123 when this is empty; production must set a strong value.
INTERNAL_API_KEY=

# Comma-separated backend origin(s) allowed by CORS.
# Example: https://your-backend-app.azurewebsites.net
BACKEND_URL=

# Optional executable overrides. Leave default for Azure Linux (system PATH).
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Optional absolute path to folder that contains ffmpeg.exe and ffprobe.exe
# Example: C:\\tools\\ffmpeg\\bin
FFMPEG_BIN=
