# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/clinix_ai
MONGODB_DNS_SERVERS=

# Authentication
JWT_SECRET=your-super-secure-jwt-secret-here
JWT_EXPIRES_IN=7d

# CORS - Comma-separated list of allowed origins
# For local development, use localhost:3000
CORS_ORIGIN=http://localhost:3000

# Frontend URL for Socket.IO
# For local development, use localhost:3000
FRONTEND_URL=http://localhost:3000

# AI Services
PYTHON_AI_SERVICE_URL=http://localhost:8001

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_API_BASE_URL=https://api.openai.com/v1

# Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-speech.json
GOOGLE_CLOUD_API_KEY=your-google-cloud-api-key-here

# Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key-here
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret-here
STRIPE_SUCCESS_URL=https://yourdomain.com/subscription/success
STRIPE_CANCEL_URL=https://yourdomain.com/subscription/cancel

# Upload Configuration
MAX_UPLOAD_SIZE_MB=50
UPLOAD_AUDIO_DIR=uploads/audio
UPLOAD_REPORTS_DIR=uploads/reports

# External APIs
RXNORM_API_ID=your-rxnorm-api-id-here
OPENFDA_API_KEY=your-openfda-api-key-here

# Twilio (Optional)
TWILIO_ACCOUNT_SID=your-twilio-account-sid-here
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Public webhook URL Twilio POSTs to (must match exactly, including https and path).
TWILIO_WEBHOOK_URL=https://your-domain.com/api/webhooks/twilio/whatsapp
# Set to false in local development only to allow unsigned simulated webhook requests.
# Production always validates regardless of this value.
TWILIO_WEBHOOK_VALIDATE=true

# Demo Mode (set to false in production)
DEMO_MODE=false

# Optional super admin bootstrap account
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=your-super-admin-password
SUPER_ADMIN_FULL_NAME=Super Admin
