# API base URL used by frontend HTTP requests.
# Leave empty or localhost in development to keep Vite proxy flow.
VITE_API_URL=http://localhost:5000

# Socket.IO backend URL. Keep in sync with backend host.
# Leave empty or localhost in development to keep Vite proxy flow.
VITE_SOCKET_URL=http://localhost:5000

# Production example values (do not commit real app URLs here):
# VITE_API_URL=https://<backend-app>.azurewebsites.net
# VITE_SOCKET_URL=https://<backend-app>.azurewebsites.net
