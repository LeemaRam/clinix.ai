{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "run-backend-dev",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev"
			],
			"isBackground": true,
			"group": "build"
		},
		{
			"label": "run-backend-dev-cmd",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"cd /d backend-node && npm.cmd run dev"
			],
			"isBackground": true,
			"group": "build"
		}
	]
}