#!/usr/bin/env bash
set -euo pipefail

# ==================================================
# Clinix.ai Azure App Services Deployment Prep Script
# Phase 3 (Provisioning + Configuration only)
# ==================================================
# This script provisions Azure resources, configures runtime settings, and
# documents the manual ZIP deployment workflow below.

# ---------- Editable variables ----------
SUBSCRIPTION_ID=""
RG_NAME="clinixai-rg"
RG_LOCATION="eastus"
LOCATION="southeastasia"
APP_SERVICE_PLAN="clinixai-plan-linux"
APP_SERVICE_SKU="B1"

# App names must be globally unique in Azure.
BACKEND_APP_NAME="clinixai-backend-prod"
AI_APP_NAME="clinixai-ai-prod"
FRONTEND_APP_NAME="clinixai-frontend-prod"

STORAGE_ACCOUNT_NAME="clinixaistorageprod01"
STORAGE_CONTAINER_NAME="clinixaistorageblobs"

BACKEND_RUNTIME="NODE|24-lts"
FRONTEND_RUNTIME="NODE|24-lts"
AI_RUNTIME="PYTHON|3.11"

# Required secrets must be exported in the shell before running this script.
# Never store real values in this tracked file.
: "${MONGODB_URI_VALUE:?Set MONGODB_URI_VALUE in the shell}"
: "${JWT_SECRET_VALUE:?Set JWT_SECRET_VALUE in the shell}"
: "${INTERNAL_API_KEY_VALUE:?Set INTERNAL_API_KEY_VALUE in the shell}"
: "${OPENAI_API_KEY_VALUE:?Set OPENAI_API_KEY_VALUE in the shell}"
STRIPE_SECRET_KEY_VALUE="${STRIPE_SECRET_KEY_VALUE:-}"
STRIPE_WEBHOOK_SECRET_VALUE="${STRIPE_WEBHOOK_SECRET_VALUE:-}"

# ---------- Azure login context ----------
az account set --subscription "$SUBSCRIPTION_ID"

# ---------- 1) Resource Group ----------
az group create \
  --name "$RG_NAME" \
  --location "$RG_LOCATION"

# ---------- 2) Linux App Service Plan ----------
az appservice plan create \
  --name "$APP_SERVICE_PLAN" \
  --resource-group "$RG_NAME" \
  --location "$LOCATION" \
  --is-linux \
  --sku "$APP_SERVICE_SKU"

# ---------- 3) Storage Account + Blob Container ----------
az storage account create \
  --name "$STORAGE_ACCOUNT_NAME" \
  --resource-group "$RG_NAME" \
  --location "$LOCATION" \
  --sku Standard_LRS \
  --kind StorageV2 \
  --allow-blob-public-access false \
  --min-tls-version TLS1_2

STORAGE_KEY=$(az storage account keys list \
  --resource-group "$RG_NAME" \
  --account-name "$STORAGE_ACCOUNT_NAME" \
  --query "[0].value" \
  --output tsv)

AZURE_STORAGE_CONNECTION_STRING=$(az storage account show-connection-string \
  --resource-group "$RG_NAME" \
  --name "$STORAGE_ACCOUNT_NAME" \
  --query connectionString \
  --output tsv)

az storage container create \
  --name "$STORAGE_CONTAINER_NAME" \
  --account-name "$STORAGE_ACCOUNT_NAME" \
  --account-key "$STORAGE_KEY"

# ---------- 4) App Service: Backend (Node.js) ----------
az webapp create \
  --resource-group "$RG_NAME" \
  --plan "$APP_SERVICE_PLAN" \
  --name "$BACKEND_APP_NAME" \
  --runtime "$BACKEND_RUNTIME"

# ---------- 5) App Service: AI Service (Python) ----------
az webapp create \
  --resource-group "$RG_NAME" \
  --plan "$APP_SERVICE_PLAN" \
  --name "$AI_APP_NAME" \
  --runtime "$AI_RUNTIME"

# ---------- 6) App Service: Frontend (Node.js SPA host) ----------
az webapp create \
  --resource-group "$RG_NAME" \
  --plan "$APP_SERVICE_PLAN" \
  --name "$FRONTEND_APP_NAME" \
  --runtime "$FRONTEND_RUNTIME"

# ---------- Shared URLs ----------
FRONTEND_URL="https://${FRONTEND_APP_NAME}.azurewebsites.net"
BACKEND_URL="https://${BACKEND_APP_NAME}.azurewebsites.net"
AI_SERVICE_URL="https://${AI_APP_NAME}.azurewebsites.net"

# ---------- Backend App Settings ----------
az webapp config appsettings set \
  --resource-group "$RG_NAME" \
  --name "$BACKEND_APP_NAME" \
  --settings \
    NODE_ENV="production" \
    SCM_DO_BUILD_DURING_DEPLOYMENT="true" \
    MONGODB_URI="$MONGODB_URI_VALUE" \
    JWT_SECRET="$JWT_SECRET_VALUE" \
    FRONTEND_URL="$FRONTEND_URL" \
    CORS_ORIGIN="$FRONTEND_URL" \
    AI_SERVICE_URL="$AI_SERVICE_URL" \
    INTERNAL_API_KEY="$INTERNAL_API_KEY_VALUE" \
    STORAGE_PROVIDER="azure" \
    AZURE_STORAGE_CONNECTION_STRING="$AZURE_STORAGE_CONNECTION_STRING" \
    AZURE_STORAGE_CONTAINER_AUDIO="$STORAGE_CONTAINER_NAME" \
    AZURE_STORAGE_CONTAINER_REPORTS="$STORAGE_CONTAINER_NAME" \
    AZURE_STORAGE_CONTAINER_PATIENT_FILES="$STORAGE_CONTAINER_NAME" \
    STRIPE_SECRET_KEY="$STRIPE_SECRET_KEY_VALUE" \
    STRIPE_WEBHOOK_SECRET="$STRIPE_WEBHOOK_SECRET_VALUE" \
    STRIPE_SUCCESS_URL="${FRONTEND_URL}/subscription/success" \
    STRIPE_CANCEL_URL="${FRONTEND_URL}/subscription/cancel"

# Enable WebSockets explicitly for Socket.IO.
az webapp config set \
  --resource-group "$RG_NAME" \
  --name "$BACKEND_APP_NAME" \
  --web-sockets-enabled true

# Backend startup command.
az webapp config set \
  --resource-group "$RG_NAME" \
  --name "$BACKEND_APP_NAME" \
  --startup-file "npm start"

# ---------- AI App Settings ----------
az webapp config appsettings set \
  --resource-group "$RG_NAME" \
  --name "$AI_APP_NAME" \
  --settings \
    NODE_ENV="production" \
    SCM_DO_BUILD_DURING_DEPLOYMENT="true" \
    BACKEND_URL="$BACKEND_URL" \
    INTERNAL_API_KEY="$INTERNAL_API_KEY_VALUE" \
    OPENAI_API_KEY="$OPENAI_API_KEY_VALUE" \
    FFMPEG_BIN="./bin" \
    FFMPEG_PATH="./bin/ffmpeg" \
    FFPROBE_PATH="./bin/ffprobe" \
    STRICT_FFMPEG="true"

# AI startup command.
az webapp config set \
  --resource-group "$RG_NAME" \
  --name "$AI_APP_NAME" \
  --startup-file 'gunicorn --worker-class uvicorn.workers.UvicornWorker --workers 2 --timeout 180 --bind 0.0.0.0:$PORT app.main:app'

# ---------- Frontend App Settings ----------
az webapp config appsettings set \
  --resource-group "$RG_NAME" \
  --name "$FRONTEND_APP_NAME" \
  --settings \
    NODE_ENV="production" \
    SCM_DO_BUILD_DURING_DEPLOYMENT="false"

# Frontend startup command (serves prebuilt dist via server.mjs).
az webapp config set \
  --resource-group "$RG_NAME" \
  --name "$FRONTEND_APP_NAME" \
  --startup-file "npm start"

# ==================================================
# Frontend Build-Time Deployment Workflow (IMPORTANT)
# ==================================================
# VITE_API_URL and VITE_SOCKET_URL are build-time variables.
# You must build frontend artifacts with production URLs before deploy.
#
# 1) Build locally (or in CI) with production endpoints baked in:
#    cd frontend
#    npm ci
#    VITE_API_URL="$BACKEND_URL" VITE_SOCKET_URL="$BACKEND_URL" npm run build
#
# 2) Package deployable frontend app (dist + server.mjs + package files):
#    cd ..
#    rm -rf frontend-release frontend-release.zip
#    mkdir -p frontend-release
#    cp -R frontend/dist frontend-release/dist
#    cp frontend/server.mjs frontend-release/server.mjs
#    cp frontend/package.json frontend-release/package.json
#    if [ -f frontend/package-lock.json ]; then cp frontend/package-lock.json frontend-release/package-lock.json; fi
#    (cd frontend-release && zip -r ../frontend-release.zip .)
#
# 3) Deploy packaged build to frontend App Service:
#    az webapp deploy --resource-group "$RG_NAME" --name "$FRONTEND_APP_NAME" --src-path "frontend-release.zip" --type zip
#
# 4) Deploy backend and AI code separately (zip deploy or your CI/CD of choice).
#    The AI release must contain Linux executable files at bin/ffmpeg and
#    bin/ffprobe. Do not include ai-service/tools/ffmpeg/ffmpeg.exe.
#
# Notes:
# - Export required *_VALUE variables in your shell before running this script.
# - Do not store real secret values in this script or shell history.
# - Prefer using Azure Key Vault + reference settings for production secrets.
